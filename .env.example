# YouTube Data API Key（可选，不设置则用 yt-dlp 搜索）
YOUTUBE_API_KEY=

# Redis 连接
REDIS_URL=redis://redis:6379/0

# 下载路径（容器内）
DOWNLOAD_BASE_PATH=/data/downloads

# 页面模式：storybook 或 general
APP_MODE=storybook

# 网页访问密钥（请替换为自己的值）
AUTH_KEY=

# Celery 队列
CELERY_QUEUE=celery

# 抖音解析服务（默认使用公开接口；如有自己的 Key 可在部署环境注入）
QSY_PARSE_API_URL=https://a.jiejing.fun/parse
QSY_PARSE_KEY=
QSY_PARSE_TYPE=sd

# 日志级别
LOG_LEVEL=INFO
